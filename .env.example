# Application
APP_NAME=SudoGuard
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql://sudoguard:secret@localhost:5432/sudoguard
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0

# API
API_HOST=0.0.0.0
API_PORT=8080
API_WORKERS=4
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Security
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24
API_KEY_HASH_ALGORITHM=sha256

# SSH Configuration
SSH_USER=sudoguard
SSH_KEY_PATH=/home/sudoguard/.ssh/id_rsa
SSH_CONTROL_PATH=/var/run/sudoguard/ssh-%r@%h:%p
SSH_CONTROL_PERSIST=600
SSH_CONNECT_TIMEOUT=10
SSH_MAX_CONNECTIONS=200
SSH_PER_HOST_LIMIT=3

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_TIME_LIMIT=3600

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# CLI
SUDOGUARD_API_KEY=your-api-key-here
